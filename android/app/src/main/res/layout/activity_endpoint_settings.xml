<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="32dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_header" android:orientation="vertical" android:padding="20dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connection settings" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Use the server addresses provided for your NepalSafe installation." android:textColor="#E2E8F0" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">

            <TextView style="@style/TextSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Early warning &amp; community" />

            <EditText android:id="@+id/warningBackendInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="http://10.0.2.2:8000" android:inputType="textUri" android:singleLine="true" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Hazard readings, forecasts, community and routes." android:textColor="@color/muted" android:textSize="12sp" />

            <TextView style="@style/TextSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Image analysis" />

            <EditText android:id="@+id/visionBackendInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="http://10.0.2.2:8001" android:inputType="textUri" android:singleLine="true" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Photo analysis and live community alerts." android:textColor="@color/muted" android:textSize="12sp" />

            <Button android:id="@+id/saveEndpointsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_primary_button" android:text="Save connections" android:textColor="@color/white" android:textStyle="bold" android:minHeight="52dp" android:textAllCaps="false" android:paddingTop="10dp" android:paddingBottom="10dp" />

            <Button android:id="@+id/testEndpointsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_chip" android:text="Check available features" android:textColor="@color/navy" android:minHeight="48dp" android:textAllCaps="false" android:paddingTop="10dp" android:paddingBottom="10dp" />

            <TextView android:id="@+id/endpointTestResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/navy_soft" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>