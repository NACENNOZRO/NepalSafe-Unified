<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_message_card" android:orientation="vertical" android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

        <TextView android:id="@+id/hopStatusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill" android:text="@string/journey_status_waiting" android:textColor="@color/badge_yellow_text" android:textSize="11sp" android:textStyle="bold" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:id="@+id/hopTimestamp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" />
    </LinearLayout>

    <TextView android:id="@+id/hopMessageContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="2dp" android:textColor="@color/navy" android:textSize="14sp" android:textStyle="bold" />

    <TextView android:id="@+id/hopCoordinates" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_pill" android:textColor="@color/badge_green_text" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />

    <Button android:id="@+id/hopPlayVoiceButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_chip" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/play_voice" android:textColor="@color/navy" android:textSize="12sp" android:visibility="gone" android:minHeight="48dp" android:textAllCaps="false" android:paddingTop="10dp" android:paddingBottom="10dp" />

    <TextView android:id="@+id/hopDetailFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="12sp" />
</LinearLayout>