<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="36dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_header" android:orientation="vertical" android:padding="20dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NepalSafe Early Warning" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Langtang Lirung • Detect · Analyse · Alert · Respond" android:textColor="#E2E8F0" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="16dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                <TextView android:id="@+id/warningConnectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connecting to live warning service…" android:textColor="@color/blue" android:textSize="14sp" android:textStyle="bold" />

                <TextView android:id="@+id/warningUpdatedAt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/muted" android:textSize="12sp" />
            </LinearLayout>

            <Button android:id="@+id/refreshWarningButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip" android:minWidth="0dp" android:text="REFRESH" android:textColor="@color/navy" android:textSize="12sp" android:minHeight="48dp" android:textAllCaps="false" android:paddingTop="10dp" android:paddingBottom="10dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="14dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">

            <TextView style="@style/TextSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Community Safety" />

            <TextView android:id="@+id/nearbySummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Checking for people and SOS calls nearby…" android:textColor="@color/navy_soft" android:textSize="14sp" />

            <TextView android:id="@+id/offlineQueueSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/warning_text" android:textSize="12sp" android:visibility="gone" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">

                <Button android:id="@+id/onlineSosButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_sos_button" android:text="SEND ONLINE SOS" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" android:minHeight="52dp" android:textAllCaps="false" android:paddingTop="10dp" android:paddingBottom="10dp" />

                <Button android:id="@+id/communityButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_primary_button" android:text="PEOPLE NEARBY" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" android:minHeight="52dp" android:textAllCaps="false" android:paddingTop="10dp" android:paddingBottom="10dp" />
            </LinearLayout>

            <Button android:id="@+id/photoAlertButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_chip" android:text="📷 ALERT NEIGHBOURS WITH A PHOTO" android:textColor="@color/navy" android:textStyle="bold" android:minHeight="48dp" android:textAllCaps="false" android:paddingTop="10dp" android:paddingBottom="10dp" />

            <Button android:id="@+id/resolveOnlineSosButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_chip" android:text="MARK MY ONLINE SOS RESOLVED" android:textColor="@color/badge_green_text" android:visibility="gone" android:minHeight="48dp" android:textAllCaps="false" android:paddingTop="10dp" android:paddingBottom="10dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/placeCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="14dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">

            <TextView android:id="@+id/placeName" style="@style/TextSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Langtang Lirung" />

            <TextView android:id="@+id/placeRegion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/muted" android:textSize="13sp" />

            <TextView android:id="@+id/placeVerdict" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_status" android:padding="12dp" android:text="Waiting for live risk…" android:textColor="@color/navy" android:textSize="18sp" android:textStyle="bold" />

            <TextView android:id="@+id/placeReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/navy_soft" android:textSize="14sp" />

            <TextView android:id="@+id/weatherSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/muted" android:textSize="13sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">

                <Button android:id="@+id/routeButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_primary_button" android:text="SAFE ROUTE" android:textColor="@color/white" android:minHeight="48dp" android:textAllCaps="false" android:paddingTop="10dp" android:paddingBottom="10dp" />

                <Button android:id="@+id/mapButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_chip" android:text="OPEN MAP" android:textColor="@color/navy" android:minHeight="48dp" android:textAllCaps="false" android:paddingTop="10dp" android:paddingBottom="10dp" />

                <Button android:id="@+id/detailsButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_chip" android:text="DETAILS" android:textColor="@color/navy" android:minHeight="48dp" android:textAllCaps="false" android:paddingTop="10dp" android:paddingBottom="10dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/TextSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginTop="20dp" android:layout_marginEnd="18dp" android:text="Hazard Early Warning" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginTop="3dp" android:layout_marginEnd="18dp" android:text="Four full Detect → Analyse → Alert → Respond pipelines" android:textColor="@color/muted" android:textSize="12sp" />

        <LinearLayout android:id="@+id/hazardContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="18dp" android:lineSpacingExtra="3dp" android:text="Monitored by the supplied XGBoost multi-hazard model using USGS tremors, NASA SRTM terrain, satellite soil water, and Open-Meteo/IMD forecasts." android:textColor="@color/muted" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>